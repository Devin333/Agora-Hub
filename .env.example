# Agora Hub local environment template.
# Keep real secrets in .env only. Do not commit .env.

# Live OpenAI-compatible LLM credentials. configs/models.yaml references this by name.
DASHSCOPE_API_KEY=

# Standard OpenAI-compatible credentials (used by the paper-chunk pipeline).
# The chunk pipeline reads OPENAI_API_KEY / OPENAI_BASE_URL first, then falls back to DASHSCOPE_*.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Runtime config paths.
NEWS_MODELS_CONFIG=configs/models.yaml
NEWS_SOURCES_CONFIG=configs/sources.yaml
NEWS_ARTIFACT_ROOT=.newsroom/runs

# Optional OpenAI-compatible overrides used by local experiments.
NEWS_LLM_MODEL=deepseek-v4-flash
NEWS_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
NEWS_LLM_API_KEY_ENV=DASHSCOPE_API_KEY
# URL-safe base64 Fernet key for encrypted activity inputs/results.
# Generate once per deployment and provide through the secret manager.
# NEWS_ACTIVITY_ENCRYPTION_KEY=

# Optional model-powered PDF visual layout parser.
# Fill these and set NEWSROOM_PAPER_PDF_PARSE_MODEL_ENABLED=true to let the visual compiler
# ask a vision model to locate figures, tables, and equations before local cropping.
NEWSROOM_PAPER_PDF_PARSE_MODEL_ENABLED=false
NEWSROOM_PAPER_PDF_PARSE_MODEL_BASE_URL=
NEWSROOM_PAPER_PDF_PARSE_MODEL_API_KEY=
NEWSROOM_PAPER_PDF_PARSE_MODEL=
NEWSROOM_PAPER_PDF_PARSE_MODEL_TIMEOUT_SECONDS=90
NEWSROOM_PAPER_PDF_PARSE_MODEL_MAX_TOKENS=1600
NEWSROOM_PAPER_PDF_PARSE_MODEL_MAX_ATTEMPTS=2

# Optional production backends. Leave NEWS_DATABASE_DSN empty for local persistence;
# the durable event runtime uses a single-host SQLite database under NEWS_ARTIFACT_ROOT.
# Use the libpq/psycopg URI form (NOT a jdbc: prefix):
#   postgresql://user:password@host:5432/dbname
NEWS_DATABASE_DSN=
NEWS_REDIS_URL=redis://127.0.0.1:6379/0
NEWS_QDRANT_URL=http://127.0.0.1:6333

# Optional router-owned LLM response cache. Disabled mode does not resolve the
# Redis URL or either secret. Production must use a dedicated rediss:// URL and
# cache-only ACL identity; do not reuse NEWS_REDIS_URL or durable runtime Redis.
NEWS_LLM_CACHE_MODE=disabled
NEWS_LLM_CACHE_BACKEND=redis
NEWS_LLM_CACHE_ENVIRONMENT=production
NEWS_LLM_CACHE_LOCAL_TEST_MODE=false
NEWS_LLM_CACHE_REDIS_URL=
NEWS_LLM_CACHE_NAMESPACE=newsroom:llm-cache
NEWS_LLM_CACHE_KEY_VERSION=v1
NEWS_LLM_CACHE_GENERATION=v1
NEWS_LLM_CACHE_KEY_SECRET=
# URL-safe base64 encoding of exactly 32 random bytes; keep it distinct from the key secret.
NEWS_LLM_CACHE_ENCRYPTION_KEY=
NEWS_LLM_CACHE_TTL_SECONDS=300
NEWS_LLM_CACHE_MAX_ENTRY_BYTES=1048576
NEWS_LLM_CACHE_CONNECT_TIMEOUT_SECONDS=1
NEWS_LLM_CACHE_SOCKET_TIMEOUT_SECONDS=1
NEWS_LLM_CACHE_SINGLEFLIGHT_ENABLED=true
NEWS_LLM_CACHE_LOCK_TTL_SECONDS=120
NEWS_LLM_CACHE_WAIT_TIMEOUT_MS=2500
NEWS_LLM_CACHE_POLL_INTERVAL_MS=50
NEWS_LLM_CACHE_PROVIDER_TIMEOUT_SECONDS=90
NEWS_LLM_CACHE_LOCK_SAFETY_MARGIN_SECONDS=15
NEWS_LLM_CACHE_REPLAY_CHUNK_SIZE=1024
NEWS_LLM_CACHE_CACHEABLE_TASK_TYPES=
NEWS_LLM_CACHE_NO_CACHE_AGENT_IDS=
NEWS_LLM_CACHE_REQUIRED_DEPENDENCIES=
# Optional strict JSON alternative to CACHEABLE_TASK_TYPES, for per-task dependencies.
NEWS_LLM_CACHE_TASK_POLICIES_JSON=

# Optional vector memory embedding settings.
NEWS_EMBEDDING_PROVIDER=openai-compatible
NEWS_EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
NEWS_EMBEDDING_MODEL=text-embedding-v4
NEWS_EMBEDDING_API_KEY_ENV=DASHSCOPE_API_KEY
NEWS_EMBEDDING_DIMENSIONS=64

# Optional multimodal visual embedding for figure image vector fusion.
# The Docker nougat service can preload this into the nougat-cache volume:
#   docker compose run --rm --entrypoint newsroom-preload-visual-model nougat
NEWS_VISUAL_EMBEDDING_ENABLED=false
NEWS_VISUAL_EMBEDDING_PROVIDER=sentence-transformers
NEWS_VISUAL_EMBEDDING_MODEL=sentence-transformers/clip-ViT-L-14
NEWS_VISUAL_VECTOR_SIZE=768
NEWS_VISUAL_EMBEDDING_DEVICE=cuda
HF_HUB_DISABLE_XET=1

# Local desktop profile (Windows, loopback only).
# The PowerShell entry fixes the project .venv and the Python launcher validates
# these values before it starts any process. Keep the two canonical-origin keys
# identical while older frontend/backend readers are migrated.
NEWSROOM_DEPLOYMENT_PROFILE=local-desktop
NEWSROOM_DESKTOP_FRONTEND_HOST=127.0.0.1
NEWSROOM_DESKTOP_FRONTEND_PORT=3000
NEWSROOM_DESKTOP_API_HOST=127.0.0.1
NEWSROOM_DESKTOP_API_PORT=8000
NEWSROOM_CANONICAL_ORIGIN=http://127.0.0.1:3000
NEWSROOM_DESKTOP_CANONICAL_ORIGIN=http://127.0.0.1:3000
NEWSROOM_API_BASE_URL=http://127.0.0.1:8000
NEWSROOM_DESKTOP_RUNTIME_ROOT=.newsroom/desktop
NEWSROOM_DESKTOP_RELEASE_ROOT=.newsroom/desktop/releases
NEWSROOM_DESKTOP_BACKUP_ROOT=.newsroom/desktop/backups
NEWSROOM_DESKTOP_CONTROL_PATH=.newsroom/local-desktop/control.json
# pymupdf runs in the prepared project environment; marker/mineru require a
# reachable, explicitly prepared Docker parser and are never downloaded by start.
NEWSROOM_DESKTOP_PARSER_MODE=pymupdf
# Optional explicit Research storage roots. Relative paths resolve from the original project root
# before a release process changes its working directory.
NEWS_RESEARCH_ROOT=.newsroom/research
NEWS_RESEARCH_RUN_STORE_ROOT=.newsroom/research/runs
NEWS_RESEARCH_RAG_LOCAL_ROOT=.newsroom/research/chunks
# Durable private Paper RAG transcript owner; launcher exports an absolute path to releases.
NEWS_RESEARCH_RAG_TRANSCRIPT_ROOT=.newsroom/research/rag/transcripts
# Optional rebuildable public paper cache used by the frontend release. Private
# reader assets remain behind authenticated API/application services.
NEWSROOM_PAPERS_DATA_PATH=.newsroom/papers/arxiv-papers.json
# Required before an explicit provider probe can prove it stays within --max-cost-usd.
# Use a conservative upper bound for the selected provider/model.
NEWSROOM_DESKTOP_PROBE_MAX_COST_PER_1K_TOKENS_USD=
