# Written by the desktop app on first run to <userData>/stack/.env (owner-only
# permissions) and updated by it afterwards; not meant to be edited by hand.
# Empty values are filled in by the app.

# Loopback port the web server is published on. The app picks 45180, or a free
# port when that one is taken, and keeps using the one it picked.
AGORA_WEB_PORT=

# Where the images are pulled from and which release, normally v<app version>.
AGORA_IMAGE_REGISTRY=ghcr.io/devin333
AGORA_IMAGE_TAG=

# 32 random bytes, standard base64. Encrypts the model API keys saved in this
# stack; losing it means entering them again.
NEWSROOM_CREDENTIAL_ENCRYPTION_KEY=

# A Fernet key (32 random bytes, URL-safe base64). Encrypts recorded research
# runs; losing it makes past run records unreadable.
NEWS_ACTIVITY_ENCRYPTION_KEY=

# Random secret the app presents to /.well-known/agora-desktop-stack to confirm
# the server on AGORA_WEB_PORT is this stack.
AGORA_DESKTOP_STACK_TOKEN=
