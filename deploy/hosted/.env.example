# Copy to .env next to compose.yaml and fill in (install.sh does this for you).
# Never commit the filled file.

# The domain users open, without scheme. It must resolve to this server; Caddy
# obtains its certificate automatically. A server with only an IP address can
# use a wildcard DNS name such as 203-0-113-7.sslip.io.
NEWSROOM_DOMAIN=agora.example.com

# Master key that encrypts every account's model API key (32 random bytes,
# base64). Generate once with:
#   openssl rand -base64 32
# Keep a copy outside this server: losing it makes every stored key unreadable
# and users must enter their keys again. Changing it has the same effect.
NEWSROOM_CREDENTIAL_ENCRYPTION_KEY=

# Key that encrypts the inputs and results recorded for every research run (a
# Fernet key: 32 random bytes, URL-safe base64). Generate once with:
#   openssl rand -base64 32 | tr '+/' '-_'
# Keep a copy outside this server as well: without it the recorded history of
# past research runs can no longer be read.
NEWS_ACTIVITY_ENCRYPTION_KEY=

# Per client address, per minute.
NEWSROOM_HOSTED_LOGIN_RATE_LIMIT_PER_MINUTE=10
# Per account, per minute.
NEWSROOM_HOSTED_RESEARCH_RATE_LIMIT_PER_MINUTE=30

# Where the api and web images are pulled from. The same images are published
# to both registries; servers in mainland China pull faster from the second:
#   ghcr.io/devin333
#   registry.cn-hangzhou.aliyuncs.com/agora-hub
AGORA_IMAGE_REGISTRY=ghcr.io/devin333
# A release such as v0.1.2, or edge for the latest main build. Pin a release
# in production so an upgrade is a deliberate change of this line, and so the
# previous release can be restored by setting it back.
AGORA_IMAGE_TAG=edge

# The private network between api and web. Change all three together only
# when 172.30.10.0/24 is already used on this host.
AGORA_APP_SUBNET=172.30.10.0/24
AGORA_API_IP=172.30.10.10
AGORA_WEB_IP=172.30.10.20

# Package indexes, used only when building the images from source with
# compose.build.yaml. Hosts in mainland China can use, for example:
#   NPM_REGISTRY=https://registry.npmmirror.com/
#   PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple/
NPM_REGISTRY=https://registry.npmjs.org/
PIP_INDEX_URL=https://pypi.org/simple
